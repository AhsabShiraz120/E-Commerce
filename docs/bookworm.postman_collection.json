{
  "info": {
    "name": "Book Worm API",
    "description": "Manual / Insomnia tests for the Book Worm capstone. Base URL and JWT are collection-level variables. Run `Auth › Login demo user` first — it stores the token into {{accessToken}} for every other request.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080/api" },
    { "key": "accessToken", "value": "" },
    { "key": "refreshToken", "value": "" }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [ { "key": "token", "value": "{{accessToken}}", "type": "string" } ]
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "url": { "raw": "{{baseUrl}}/auth/register", "host": ["{{baseUrl}}"], "path": ["auth","register"] },
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"reader+{{$timestamp}}@example.com\",\n  \"password\": \"Str0ng@Pass\",\n  \"firstName\": \"Priya\",\n  \"lastName\": \"Sharma\",\n  \"phone\": \"+91-98765-43210\"\n}" }
          },
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": [
              "const j = pm.response.json();",
              "pm.collectionVariables.set('accessToken', j.accessToken);",
              "pm.collectionVariables.set('refreshToken', j.refreshToken);"
            ]}
          }]
        },
        {
          "name": "Login (demo user)",
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth","login"] },
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"demo@bookworm.io\",\n  \"password\": \"Demo@123\"\n}" }
          },
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": [
              "const j = pm.response.json();",
              "pm.collectionVariables.set('accessToken', j.accessToken);",
              "pm.collectionVariables.set('refreshToken', j.refreshToken);"
            ]}
          }]
        },
        {
          "name": "Refresh token",
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "url": { "raw": "{{baseUrl}}/auth/refresh", "host": ["{{baseUrl}}"], "path": ["auth","refresh"] },
            "body": { "mode": "raw", "raw": "{ \"refreshToken\": \"{{refreshToken}}\" }" }
          }
        }
      ]
    },
    {
      "name": "Me",
      "item": [
        { "name": "Get me",       "request": { "method": "GET",    "url": { "raw": "{{baseUrl}}/me",           "host": ["{{baseUrl}}"], "path": ["me"] } } },
        { "name": "Update me",    "request": { "method": "PUT",    "url": { "raw": "{{baseUrl}}/me",           "host": ["{{baseUrl}}"], "path": ["me"] }, "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{ \"phone\": \"+91-99999-00000\" }" } } },
        { "name": "List addresses", "request": { "method": "GET",  "url": { "raw": "{{baseUrl}}/me/addresses", "host": ["{{baseUrl}}"], "path": ["me","addresses"] } } },
        {
          "name": "Add address",
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "url": { "raw": "{{baseUrl}}/me/addresses", "host": ["{{baseUrl}}"], "path": ["me","addresses"] },
            "body": { "mode": "raw", "raw": "{\n  \"line1\": \"221B Baker Street\",\n  \"city\": \"Bengaluru\",\n  \"state\": \"KA\",\n  \"pin\": \"560001\",\n  \"phone\": \"+91-98000-00000\",\n  \"isDefault\": true\n}" }
          }
        }
      ]
    },
    {
      "name": "Catalog",
      "item": [
        { "name": "List categories", "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/categories", "host": ["{{baseUrl}}"], "path": ["categories"] } } },
        { "name": "List brands",     "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/brands",     "host": ["{{baseUrl}}"], "path": ["brands"] } } },
        { "name": "Search books (Self-help, popular)", "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/books?category=self-help&sort=popular", "host": ["{{baseUrl}}"], "path": ["books"], "query": [ { "key": "category", "value": "self-help" }, { "key": "sort", "value": "popular" } ] } } },
        { "name": "Get book 1",     "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/books/1",     "host": ["{{baseUrl}}"], "path": ["books","1"] } } },
        { "name": "Related books",  "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/books/1/related", "host": ["{{baseUrl}}"], "path": ["books","1","related"] } } },
        { "name": "Recommended",    "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/books/recommended?limit=6", "host": ["{{baseUrl}}"], "path": ["books","recommended"], "query": [ { "key": "limit", "value": "6" } ] } } },
        { "name": "List reviews for book 1", "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/books/1/reviews", "host": ["{{baseUrl}}"], "path": ["books","1","reviews"] } } },
        {
          "name": "Add review to book 1",
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "url": { "raw": "{{baseUrl}}/books/1/reviews", "host": ["{{baseUrl}}"], "path": ["books","1","reviews"] },
            "body": { "mode": "raw", "raw": "{ \"rating\": 5, \"text\": \"Genuinely changed how I plan my day.\" }" }
          }
        }
      ]
    },
    {
      "name": "Cart",
      "item": [
        { "name": "Get cart",     "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/cart", "host": ["{{baseUrl}}"], "path": ["cart"] } } },
        { "name": "Add to cart (book 1 × 2)", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "url": { "raw": "{{baseUrl}}/cart/items", "host": ["{{baseUrl}}"], "path": ["cart","items"] }, "body": { "mode": "raw", "raw": "{ \"bookId\": 1, \"quantity\": 2 }" } } },
        { "name": "Update line 1 → qty 3", "request": { "method": "PUT", "header": [{ "key": "Content-Type", "value": "application/json" }], "url": { "raw": "{{baseUrl}}/cart/items/1", "host": ["{{baseUrl}}"], "path": ["cart","items","1"] }, "body": { "mode": "raw", "raw": "{ \"quantity\": 3 }" } } },
        { "name": "Remove cart line 1", "request": { "method": "DELETE", "url": { "raw": "{{baseUrl}}/cart/items/1", "host": ["{{baseUrl}}"], "path": ["cart","items","1"] } } }
      ]
    },
    {
      "name": "Wishlist",
      "item": [
        { "name": "Get wishlist", "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/wishlist", "host": ["{{baseUrl}}"], "path": ["wishlist"] } } },
        { "name": "Add to wishlist (book 3)", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "url": { "raw": "{{baseUrl}}/wishlist/items", "host": ["{{baseUrl}}"], "path": ["wishlist","items"] }, "body": { "mode": "raw", "raw": "{ \"bookId\": 3 }" } } },
        { "name": "Remove wishlist line 1", "request": { "method": "DELETE", "url": { "raw": "{{baseUrl}}/wishlist/items/1", "host": ["{{baseUrl}}"], "path": ["wishlist","items","1"] } } }
      ]
    },
    {
      "name": "Orders",
      "item": [
        { "name": "Checkout (address 1)", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "url": { "raw": "{{baseUrl}}/orders/checkout", "host": ["{{baseUrl}}"], "path": ["orders","checkout"] }, "body": { "mode": "raw", "raw": "{ \"addressId\": 1, \"useGiftPoints\": 0 }" } } },
        { "name": "Pay for order 1 (success)", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "url": { "raw": "{{baseUrl}}/orders/1/pay", "host": ["{{baseUrl}}"], "path": ["orders","1","pay"] }, "body": { "mode": "raw", "raw": "{ \"method\": \"CREDIT\", \"cardNumber\": \"4111111111111234\", \"cardholderName\": \"Priya Sharma\", \"expiry\": \"12/28\", \"cvv\": \"123\" }" } } },
        { "name": "Pay for order 1 (decline — card ends in 0000)", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "url": { "raw": "{{baseUrl}}/orders/1/pay", "host": ["{{baseUrl}}"], "path": ["orders","1","pay"] }, "body": { "mode": "raw", "raw": "{ \"method\": \"CREDIT\", \"cardNumber\": \"4111111111110000\", \"cardholderName\": \"Priya Sharma\", \"expiry\": \"12/28\", \"cvv\": \"123\" }" } } },
        { "name": "List my orders", "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/orders", "host": ["{{baseUrl}}"], "path": ["orders"] } } },
        { "name": "Get order 1",     "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/orders/1", "host": ["{{baseUrl}}"], "path": ["orders","1"] } } },
        { "name": "Cancel order 1",  "request": { "method": "POST", "url": { "raw": "{{baseUrl}}/orders/1/cancel", "host": ["{{baseUrl}}"], "path": ["orders","1","cancel"] } } },
        { "name": "Buy again (order 1)", "request": { "method": "POST", "url": { "raw": "{{baseUrl}}/orders/1/buy-again", "host": ["{{baseUrl}}"], "path": ["orders","1","buy-again"] } } }
      ]
    },
    {
      "name": "Shipping",
      "item": [
        { "name": "Quote for PIN 560001 (₹200)", "request": { "auth": { "type": "noauth" }, "method": "GET", "url": { "raw": "{{baseUrl}}/shipping/quote?pin=560001&subtotalPaise=20000", "host": ["{{baseUrl}}"], "path": ["shipping","quote"], "query": [ { "key": "pin", "value": "560001" }, { "key": "subtotalPaise", "value": "20000" } ] } } },
        { "name": "Quote for PIN 560001 (₹1000 — free)", "request": { "auth": { "type": "noauth" }, "method": "GET", "url": { "raw": "{{baseUrl}}/shipping/quote?pin=560001&subtotalPaise=100000", "host": ["{{baseUrl}}"], "path": ["shipping","quote"], "query": [ { "key": "pin", "value": "560001" }, { "key": "subtotalPaise", "value": "100000" } ] } } }
      ]
    }
  ]
}
